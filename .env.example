# Copy to .env and fill in real values. .env is git-ignored.

# --- Database ---
MYSQL_DATABASE=eastern_standard
MYSQL_USER=wp
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# --- Ports (8080/8081 and 8090/8091 are used by sibling projects) ---
WP_PORT=8100
PMA_PORT=8101
MAILPIT_PORT=8102
N8N_PORT=8103

# --- WordPress site ---
WP_URL=http://localhost:8100
WP_TITLE="Eastern Standard Studio (Demo)"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me
WP_ADMIN_EMAIL=you@example.com

# --- Studio settings ---
# Booking slots are generated in this timezone and stored as UTC.
ESS_STUDIO_TIMEZONE=America/New_York
ESS_STUDIO_EMAIL=studio@easternstandard.test

# --- Automation ---
# Outbound: WordPress POSTs each booking here. n8n is on the internal Docker
# network, so this hostname resolves from the wordpress container and never
# changes between restarts.
ESS_WEBHOOK_URL=http://n8n:5678/webhook/ess-booking

# Inbound: n8n must send this back in the x-ess-signature header when it calls
# the REST callback that marks a booking confirmed. Generate with:
#   openssl rand -hex 32
ESS_WEBHOOK_SECRET=change-me

# Pinned so credentials exported to n8n/credentials/ stay decryptable after a
# rebuild. Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me
